<hc:GlowWindow
    x:Class="DevelopToolsCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DevelopToolsCore.ViewModels"
    Title="{DynamicResource AppTitle}"
    Width="800"
    Height="600"
    MinWidth="760"
    MinHeight="590"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    Background="#F4F6F9"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    ResizeMode="CanResizeWithGrip"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:GlowWindow.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E7EF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#68748A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EEF4FF" />
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#8EB1F5" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#287A52" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#EAF7F0" />
        <SolidColorBrush x:Key="WarningBrush" Color="#8A6223" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SelectionCardToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="CardBorder"
                            Padding="12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="SelectionBox"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="#C9D0DC"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        x:Name="CheckGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="✓"
                                        Visibility="Collapsed" />
                                </Border>

                                <Border
                                    x:Name="IconBorder"
                                    Grid.Column="2"
                                    Width="34"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Background="#E9F0FE"
                                    CornerRadius="8">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#315DA8"
                                        Text="{TemplateBinding Tag}" />
                                </Border>

                                <ContentPresenter
                                    Grid.Column="4"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#B8C5D8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter TargetName="SelectionBox" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconBorder" Property="Background" Value="#DCE8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopeRadioStyle" TargetType="RadioButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="ScopeBorder"
                            Padding="11,10"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="18"
                                    Height="18"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="#BFC8D5"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <Ellipse
                                        x:Name="SelectionDot"
                                        Width="8"
                                        Height="8"
                                        Fill="{StaticResource AccentBrush}"
                                        Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter
                                    Grid.Column="2"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScopeBorder" Property="BorderBrush" Value="#B8C5D8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ScopeBorder" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="ScopeBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AFC1E8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:GlowWindow.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="9">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="R" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{DynamicResource AppTitle}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{DynamicResource AppSubtitle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{DynamicResource SwitchLanguage}" />
                    <ComboBox
                        Width="116"
                        Height="34"
                        HorizontalContentAlignment="Center"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>

                <Border
                    Grid.Column="5"
                    Padding="10,7"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink
                            Click="Hyperlink_Click"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            NavigateUri="https://github.com/iamlovedit/Revit_Develop_Tools"
                            TextDecorations="{x:Null}">
                            <Run Text="GitHub" />
                            <Run Text=" ↗" />
                        </Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource SelectRevitVersion}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{DynamicResource DetectedVersionsHint}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=VersionItems}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl x:Name="VersionItems" ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            Tag="R"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            Style="{StaticResource SelectionCardToggleStyle}"
                                            ToolTip="{Binding RevitProduct.InstallLocation}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource PrimaryTextBrush}"
                                                        Text="{Binding RevitProduct.Name}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="{Binding RevitProduct.InstallLocation}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Padding="7,3"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SuccessLightBrush}"
                                                    CornerRadius="10">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        Text="{DynamicResource Detected}" />
                                                </Border>
                                            </Grid>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.TextAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=VersionItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                Background="{StaticResource AccentLightBrush}"
                                CornerRadius="24">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="R" />
                            </Border>
                            <TextBlock
                                Margin="0,12,0,0"
                                Style="{StaticResource SectionTitleStyle}"
                                Text="{DynamicResource NoRevitDetected}" />
                            <TextBlock
                                MaxWidth="250"
                                Margin="0,6,0,0"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{DynamicResource NoRevitDetectedHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="61*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="39*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource InstallTools}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{DynamicResource InstallToolsHint}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <ToggleButton
                                Tag="A"
                                IsChecked="{Binding IsManagerChecked, Mode=TwoWay}"
                                Style="{StaticResource SelectionCardToggleStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Add-in Manager" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{DynamicResource AddinManagerDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                Margin="0"
                                Tag="L"
                                IsChecked="{Binding IsLookupChecked, Mode=TwoWay}"
                                Style="{StaticResource SelectionCardToggleStyle}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Revit Lookup" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{DynamicResource RevitLookupDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Padding="16,14"
                    Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource InstallScope}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{DynamicResource InstallScopeHint}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                Grid.Column="0"
                                Content="{DynamicResource CurrentUser}"
                                GroupName="InstallScope"
                                IsChecked="{Binding IsCurrentUser, Mode=TwoWay}"
                                Style="{StaticResource ScopeRadioStyle}" />
                            <RadioButton
                                Grid.Column="2"
                                Content="{DynamicResource AllUsers}"
                                GroupName="InstallScope"
                                Style="{StaticResource ScopeRadioStyle}" />
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                Foreground="{StaticResource WarningBrush}"
                                Text="◆" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource WarningBrush}"
                                Text="{DynamicResource AdminPermissionHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{StaticResource SuccessLightBrush}"
                    CornerRadius="14">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{StaticResource SuccessBrush}"
                        Text="✓" />
                </Border>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding InstallStatus}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InstallStatus}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{DynamicResource ReadyStatus}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstallStatus}" Value="">
                                    <Setter Property="Text" Value="{DynamicResource ReadyStatus}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button
                    Grid.Column="3"
                    Command="{Binding SetupCommand}"
                    IsEnabled="{Binding CanInstall}"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Start}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="→" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</hc:GlowWindow>
