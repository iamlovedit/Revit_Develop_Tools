<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Header">Revit开发环境配置</sys:String>
    <sys:String x:Key="AppTitle">Revit 开发工具</sys:String>
    <sys:String x:Key="AppSubtitle">安装和管理常用开发插件</sys:String>
    <sys:String x:Key="CurrentUser">当前用户</sys:String>
    <sys:String x:Key="AllUsers">所有用户</sys:String>
    <sys:String x:Key="Start">开始安装</sys:String>
    <sys:String x:Key="SwitchLanguage">语言</sys:String>
    <sys:String x:Key="SelectRevitVersion">选择 Revit 版本</sys:String>
    <sys:String x:Key="DetectedVersionsHint">已自动检测本机安装版本</sys:String>
    <sys:String x:Key="Detected">已检测</sys:String>
